# ═══════════════════════════════════════════════════════
# Sakura Studio — Variables de Entorno
# ═══════════════════════════════════════════════════════
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).


# ─── Base de Datos ──────────────────────────────────────
# URL de conexión a PostgreSQL.
# Local (instalación propia):
#   DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/sakura_studio"
# Neon (recomendado para producción, gratis):
#   Crea una base de datos gratis en https://neon.tech
#   DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=


# ─── Autenticación JWT ──────────────────────────────────
# Clave secreta para firmar los tokens de sesión (JWT).
# Genera una con este comando:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: Usa una clave diferente en cada entorno (dev, staging, prod).
JWT_SECRET=


# ─── Configuración Avanzada ─────────────────────────────
# Solo es necesario si usas un esquema personalizado en PostgreSQL.
# DATABASE_SCHEMA=
