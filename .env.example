# Sakura Studio — Variables de Entorno
# Copia este archivo como .env y completa los valores

# Base de datos (Neon PostgreSQL)
# Obtén esta URL creando una base de datos gratis en https://neon.tech
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/sakura-studio?sslmode=require"

# Secreto JWT para sesiones
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="tu-secreto-jwt-aqui-cambiame-en-produccion"
